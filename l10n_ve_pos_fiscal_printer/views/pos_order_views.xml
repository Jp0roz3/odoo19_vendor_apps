<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_fiscal_printer" model="ir.ui.view">
        <field name="name">pos.order.form.fiscal.printer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Datos Fiscales (SENIAT)" name="fiscal_data" invisible="not is_fiscal_printed and not fiscal_invoice_number">
                    <group>
                        <group string="Identificación Fiscal">
                            <field name="is_fiscal_printed" widget="boolean_toggle"/>
                            <field name="fiscal_invoice_number"/>
                            <field name="fiscal_control_number"/>
                        </group>
                        <group string="Dispositivo y Auditoría">
                            <field name="fiscal_printer_serial"/>
                            <field name="fiscal_z_number"/>
                            <field name="fiscal_print_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_fiscal_printer" model="ir.ui.view">
        <field name="name">pos.order.tree.fiscal.printer</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="fiscal_control_number" optional="hide"/>
                <field name="fiscal_printer_serial" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
