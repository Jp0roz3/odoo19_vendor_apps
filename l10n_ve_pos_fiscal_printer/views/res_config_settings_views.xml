<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fiscal_printer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fiscal.printer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="after">
                <block title="Impresoras Fiscales Venezuela (SENIAT)" id="pos_fiscal_printer_section">
                    <setting string="Control Fiscal SENIAT" help="Conexión con impresoras fiscales Bixolon SRP-812, DT230, HKA80, PP9.">
                        <field name="fiscal_printer_active"/>
                        <div class="content-group mt16" invisible="not fiscal_printer_active">
                            <div class="row mt8">
                                <label for="fiscal_printer_model" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_model" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="fiscal_printer_conn_type" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_conn_type" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="fiscal_printer_conn_type != 'local_agent'">
                                <label for="fiscal_printer_agent_url" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_agent_url" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="fiscal_printer_conn_type not in ['local_agent', 'web_serial']">
                                <label for="fiscal_printer_port" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_port" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="fiscal_printer_conn_type not in ['local_agent', 'web_serial']">
                                <label for="fiscal_printer_baudrate" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_baudrate" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="fiscal_printer_conn_type != 'tcp'">
                                <label for="fiscal_printer_tcp_ip" class="col-lg-4 o_light_label"/>
                                <field name="fiscal_printer_tcp_ip" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
