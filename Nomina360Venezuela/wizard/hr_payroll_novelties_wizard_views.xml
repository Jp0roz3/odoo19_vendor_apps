<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_novelties_wizard_form" model="ir.ui.view">
        <field name="name">hr.payroll.novelties.wizard.form</field>
        <field name="model">hr.payroll.novelties.wizard</field>
        <field name="arch" type="xml">
            <form string="Carga Masiva de Variaciones de Nómina">
                <group>
                    <group>
                        <field name="payslip_run_id"/>
                        <field name="csv_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <button name="action_load_csv" string="📂 Cargar desde Archivo CSV" type="object" class="btn-primary"/>
                    </group>
                </group>
                <notebook>
                    <page string="Matriz de Variaciones a Aplicar">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="employee_id"/>
                                <field name="novelty_type"/>
                                <field name="quantity"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_apply_novelties" string="⚡ Aplicar Variaciones a Nómina" type="object" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_novelties_wizard" model="ir.actions.act_window">
        <field name="name">Carga Masiva de Variaciones</field>
        <field name="res_model">hr.payroll.novelties.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
