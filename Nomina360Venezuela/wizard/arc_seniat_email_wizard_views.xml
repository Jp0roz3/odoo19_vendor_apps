<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arc_seniat_email_wizard_form" model="ir.ui.view">
        <field name="name">arc.seniat.email.wizard.form</field>
        <field name="model">arc.seniat.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Envío Masivo por Email de Comprobantes AR-C SENIAT">
                <group>
                    <group>
                        <field name="year"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="email_subject"/>
                        <field name="sent_count"/>
                    </group>
                </group>
                <notebook>
                    <page string="Selección de Empleados (Opcional)">
                        <field name="employee_ids" widget="many2many_tags"/>
                    </page>
                    <page string="Plantilla del Mensaje de Correo">
                        <field name="email_body"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_send_arc_emails" string="📧 Enviar Comprobantes AR-C por Correo" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_arc_seniat_email_wizard" model="ir.actions.act_window">
        <field name="name">Certificados AR-C y Envío Masivo</field>
        <field name="res_model">arc.seniat.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
