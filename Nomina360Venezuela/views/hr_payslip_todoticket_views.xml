<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Lista -->
        <record id="view_hr_payslip_todoticket_list" model="ir.ui.view">
            <field name="name">hr.payslip.todoticket.list</field>
            <field name="model">hr.payslip.todoticket</field>
            <field name="arch" type="xml">
                <list string="TXT TodoTicket Cestaticket"
                      decoration-success="state == 'done'"
                      decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="date_payment"/>
                    <field name="company_code"/>
                    <field name="total_records"/>
                    <field name="amount_total_bs" string="Monto Total (Bs)" sum="Total Bs"/>
                    <field name="amount_total_usd" string="Monto Total ($ USD)" sum="Total USD" optional="show"/>
                    <field name="tasa_bcv" string="Tasa BCV" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'draft'"
                           decoration-danger="state == 'cancel'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Vista Formulario -->
        <record id="view_hr_payslip_todoticket_form" model="ir.ui.view">
            <field name="name">hr.payslip.todoticket.form</field>
            <field name="model">hr.payslip.todoticket</field>
            <field name="arch" type="xml">
                <form string="TXT TodoTicket Cestaticket">
                    <header>
                        <button name="load_payslips"
                                string="Cargar Nóminas de Lotes"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ('done','cancel')"/>
                        <button name="generate_txt"
                                string="Generar Archivo TXT"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ('done','cancel')"/>
                        <button name="action_done"
                                string="Marcar como Procesado"
                                type="object"
                                invisible="state in ('done','cancel')"
                                confirm="¿Está seguro que desea marcar este abono como Procesado?"/>
                        <button name="action_cancel"
                                string="Anular"
                                type="object"
                                invisible="state == 'cancel'"
                                confirm="¿Está seguro que desea anular este abono?"/>
                        <button name="action_draft"
                                string="Pasar a Borrador"
                                type="object"
                                invisible="state in ('draft','done')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Parámetros del Abono">
                                <field name="company_code" readonly="state in ('done','cancel')"/>
                                <field name="date_payment" readonly="state in ('done','cancel')"/>
                                <field name="payslip_run_ids"
                                       widget="many2many_tags"
                                       readonly="state in ('done','cancel')"
                                       options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       readonly="state in ('done','cancel')"/>
                            </group>
                            <group string="Totales y Archivo Resultante">
                                <field name="total_records"/>
                                <label for="amount_total_bs" string="Monto Total en Bolívares"/>
                                <div class="o_row">
                                    <field name="amount_total_bs" class="oe_inline"/>
                                    <span class="oe_inline"><b> Bs.</b></span>
                                </div>
                                <field name="tasa_bcv" string="Tasa BCV Aplicada"/>
                                <label for="amount_total_usd" string="Monto Ref. Dólares"/>
                                <div class="o_row">
                                    <span class="oe_inline"><b>$ </b></span>
                                    <field name="amount_total_usd" class="oe_inline"/>
                                    <span class="oe_inline"><b> USD</b></span>
                                </div>
                                <field name="txt_filename" invisible="1"/>
                                <field name="txt_file" filename="txt_filename" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalle de Empleados y Recibos">
                                <field name="line_ids" nolabel="1" readonly="state in ('done','cancel')">
                                    <list string="Detalle Empleados" editable="bottom">
                                        <field name="number"/>
                                        <field name="nationality"/>
                                        <field name="identification_id"/>
                                        <field name="employee_name"/>
                                        <field name="amount_bs" string="Monto a Abonar (Bs)" sum="Total Abono (Bs)"/>
                                        <field name="amount_usd" string="Monto Ref. ($ USD)" sum="Total ($ USD)" optional="show"/>
                                        <field name="tasa_bcv" string="Tasa BCV" optional="hide"/>
                                        <field name="payslip_id" optional="hide"/>
                                        <field name="employee_id" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Acción de Ventana -->
        <record id="action_hr_payslip_todoticket" model="ir.actions.act_window">
            <field name="name">TXT TodoTicket Cestaticket</field>
            <field name="res_model">hr.payslip.todoticket</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo lote de abono TodoTicket Cestaticket
                </p>
                <p>
                    Seleccione uno o varios lotes de nómina procesados, cargue los empleados y genere el archivo plano TXT oficial exigido por TodoTicket.
                </p>
            </field>
        </record>
    </data>
</odoo>
