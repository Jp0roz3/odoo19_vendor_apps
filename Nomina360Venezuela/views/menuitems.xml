<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Nómina Venezuela 360 - Menú Principal de Aplicación
        ====================================================
        Crea la aplicación independiente "Nómina Venezuela 360" en la pantalla de inicio
        y la barra de navegación superior idéntica a la referencia.
    -->

    <!-- 1. Aplicación Principal en la Pantalla de Inicio y Barra Superior -->
    <menuitem id="menu_nomina_venezuela_app_root"
              name="Nómina Venezuela 360"
              web_icon="Nomina360Venezuela,static/description/icon.png"
              sequence="40"/>

    <!-- 2. Menú Desplegable Principal: Nómina Venezuela 360 -->
    <menuitem id="menu_nomina_venezuela_root"
              name="Nómina Venezuela 360"
              parent="menu_nomina_venezuela_app_root"
              sequence="10"/>

    <!-- Elementos del Menú Desplegable en el Orden Exacto de la Referencia -->
    <menuitem id="menu_hr_payroll_dashboard_bi"
              name="📊 Tablero BI Gerencial 360"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_dashboard_bi"
              sequence="1"/>

    <menuitem id="menu_hr_payroll_ai_chat"
              name="🤖 Chat Directo Nubelco AI (LOTTT)"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_ai_chat"
              sequence="2"/>

    <menuitem id="menu_hr_contract_ve"
              name="Contratos de Trabajo"
              parent="menu_nomina_venezuela_root"
              action="action_hr_contract_ve"
              sequence="3"/>

    <menuitem id="menu_hr_payslip_run_ve"
              name="Lotes y Períodos"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payslip_run_ve"
              sequence="4"/>

    <menuitem id="menu_hr_payroll_novelties_wizard"
              name="⚡ Carga Masiva de Variaciones"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_novelties_wizard"
              sequence="5"/>

    <menuitem id="menu_hr_payslip_ve"
              name="Recibos de Nómina"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payslip_ve"
              sequence="6"/>

    <menuitem id="menu_hr_prestaciones"
              name="Prestaciones Sociales (LOTTT)"
              parent="menu_nomina_venezuela_root"
              action="action_hr_prestaciones_line"
              sequence="7"/>

    <menuitem id="menu_hr_payroll_provision"
              name="📊 Provisiones Contables Mensuales"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_provision"
              sequence="8"/>

    <menuitem id="menu_hr_prestaciones_anticipo"
              name="Anticipos de Prestaciones (Art. 144)"
              parent="menu_nomina_venezuela_root"
              action="action_hr_prestaciones_anticipo"
              sequence="9"/>

    <menuitem id="menu_hr_loan_ve"
              name="💵 Préstamos y Adelantos"
              parent="menu_nomina_venezuela_root"
              action="action_hr_loan_ve"
              sequence="10"/>

    <menuitem id="menu_hr_liquidacion"
              name="Liquidaciones y Finiquitos"
              parent="menu_nomina_venezuela_root"
              action="action_hr_liquidacion"
              sequence="11"/>

    <menuitem id="menu_bank_payroll_export"
              name="Disquetes Bancarios Masivos"
              parent="menu_nomina_venezuela_root"
              action="action_bank_payroll_export_wizard"
              sequence="12"/>

    <menuitem id="menu_hr_payslip_todoticket"
              name="💳 Abonos TXT TodoTicket Cestaticket"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payslip_todoticket"
              sequence="13"/>

    <menuitem id="menu_hr_payroll_bank_approval"
              name="🏛️ Validación Financiera Bancaria"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_bank_approval"
              sequence="14"/>

    <menuitem id="menu_tiuna_faov_export"
              name="Portales Oficiales (TIUNA / FAOV)"
              parent="menu_nomina_venezuela_root"
              action="action_tiuna_faov_export_wizard"
              sequence="15"/>

    <menuitem id="menu_legal_reports_wizard"
              name="🏛️ Entregables Legales (SENIAT/IVSS/MINTRA/INCES)"
              parent="menu_nomina_venezuela_root"
              action="action_legal_reports_wizard"
              sequence="16"/>

    <menuitem id="menu_arc_seniat_email_wizard"
              name="📧 Certificados AR-C y Envío Masivo"
              parent="menu_nomina_venezuela_root"
              action="action_arc_seniat_email_wizard"
              sequence="17"/>

    <menuitem id="menu_hr_payroll_migration_wizard"
              name="📦 Migración de Datos y Acumulados"
              parent="menu_nomina_venezuela_root"
              action="action_hr_payroll_migration_wizard"
              sequence="18"/>

    <!-- 3. Menú de Configuración en la Barra Superior -->
    <record id="action_nomina360_config_settings" model="ir.actions.act_window">
        <field name="name">Configuración Nómina Venezuela 360</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'Nomina360Venezuela'}</field>
    </record>

    <menuitem id="menu_nomina_venezuela_config_root"
              name="Configuración"
              parent="menu_nomina_venezuela_app_root"
              sequence="90"/>

    <menuitem id="menu_nomina_venezuela_settings"
              name="⚙️ Ajustes Parámetros LOTTT / BCV"
              parent="menu_nomina_venezuela_config_root"
              action="action_nomina360_config_settings"
              sequence="1"/>

    <menuitem id="menu_hr_payroll_ai_session"
              name="💬 Historial &amp; Sesiones de IA"
              parent="menu_nomina_venezuela_config_root"
              action="action_hr_payroll_ai_session"
              sequence="10"/>

    <menuitem id="menu_hr_payroll_ai_assistant"
              name="📋 Registro de Consultas IA Laboral"
              parent="menu_nomina_venezuela_config_root"
              action="action_hr_payroll_ai_assistant"
              sequence="20"/>

</odoo>
