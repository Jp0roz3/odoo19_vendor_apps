<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas Visuales Nativas Odoo 19 (Stat Buttons, Native Cards & Chatter) -->
    <record id="view_hr_payroll_ai_session_tree" model="ir.ui.view">
        <field name="name">hr.payroll.ai.session.tree</field>
        <field name="model">hr.payroll.ai.session</field>
        <field name="arch" type="xml">
            <list string="Historial de Conversaciones de IA Laboral">
                <field name="create_date" string="Fecha Inicio"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="employee_id"/>
                <field name="ai_provider"/>
                <field name="message_count" string="Mensajes"/>
                <field name="is_simulation_mode" widget="boolean_toggle"/>
                <field name="write_date" string="Última Actividad"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_ai_session_form" model="ir.ui.view">
        <field name="name">hr.payroll.ai.session.form</field>
        <field name="model">hr.payroll.ai.session</field>
        <field name="arch" type="xml">
            <form string="Sesión Inteligente de IA Laboral">
                <header>
                    <button name="action_send_message" string="⚡ Enviar Mensaje" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <!-- Caja de Botones Estadísticos Nativos de Odoo 19 -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-comments">
                            <field name="message_count" widget="statinfo" string="Mensajes"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-usd">
                            <field name="bcv_rate_display" widget="statinfo" string="Tasa BCV"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Título de la Consulta"/>
                        <h1><field name="name" placeholder="Ej: Consulta Salarial y Prestaciones María Benítez"/></h1>
                    </div>

                    <group>
                        <group string="Contexto de la Sesión">
                            <field name="employee_id" placeholder="Seleccione un empleado para análisis directo..."/>
                            <field name="user_id" readonly="1" widget="many2one_avatar"/>
                        </group>
                        <group string="Parámetros del Motor">
                            <field name="ai_provider"/>
                            <field name="is_simulation_mode" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <!-- Accesos Rápidos Nativos (Prompt Chips) -->
                    <div class="card bg-body-tertiary mb-3">
                        <div class="card-body py-2 px-3">
                            <span class="text-muted small fw-bold me-3">⚡ ACCESOS RÁPIDOS (PROMPT CHIPS):</span>
                            <button name="action_quick_prestaciones" string="💰 Prestaciones Art. 142" type="object" class="btn btn-outline-primary btn-sm me-2 rounded-pill"/>
                            <button name="action_quick_anticipo" string="🏥 Anticipo 75% Art. 144" type="object" class="btn btn-outline-warning btn-sm me-2 rounded-pill"/>
                            <button name="action_quick_cestaticket" string="🍽️ Cestaticket $40 BCV" type="object" class="btn btn-outline-success btn-sm me-2 rounded-pill"/>
                            <button name="action_quick_seniat" string="🏛️ Pensiones 9% SENIAT" type="object" class="btn btn-outline-info btn-sm rounded-pill"/>
                        </div>
                    </div>

                    <group string="Escribe tu mensaje">
                        <field name="input_text" placeholder="Escribe tu consulta laboral o legal aquí..." rows="2" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="💬 Conversación Activa (Nativa Odoo 19)" name="history">
                            <field name="history_html" widget="html" readonly="1"/>
                        </page>
                        <page string="📋 Mensajes de Registro" name="messages_tab">
                            <field name="message_ids" readonly="1">
                                <list string="Registro de Mensajes">
                                    <field name="date"/>
                                    <field name="role"/>
                                    <field name="content"/>
                                    <field name="is_simulation"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_ai_session" model="ir.actions.act_window">
        <field name="name">💬 Historial &amp; Sesiones de IA</field>
        <field name="res_model">hr.payroll.ai.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Inicia una nueva Sesión Inteligente con Nubelco AI!
            </p>
            <p>
                Consulta salarios, prestaciones, anticipos y retenciones con el diseño visual nativo de Odoo 19.
            </p>
        </field>
    </record>
</odoo>
