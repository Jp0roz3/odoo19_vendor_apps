<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ve" model="ir.ui.view">
        <field name="name">res.config.settings.form.ve</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Nómina Venezuela 360" string="Nómina Venezuela 360" name="Nomina360Venezuela">
                    <block title="Parámetros Legales de Venezuela (LOTTT)">
                        <setting string="Sincronización Tasa BCV" help="Sincronizar automáticamente la tasa oficial del Banco Central de Venezuela.">
                            <field name="bcv_rate_api_enabled"/>
                            <div invisible="not bcv_rate_api_enabled">
                                <field name="current_bcv_rate"/>
                            </div>
                        </setting>
                        <setting string="Nivel de Riesgo IVSS Patronal" help="Nivel de riesgo asignado por el IVSS (9%, 10% o 11%).">
                            <field name="ivss_risk_level"/>
                        </setting>
                        <setting string="Cesta Ticket Socialista (USD)" help="Monto decretado en dólares ($40.00).">
                            <field name="cesta_ticket_usd"/>
                        </setting>
                        <setting string="Salario Mínimo Nacional (Bs)" help="Salario Mínimo para topes IVSS/SPF.">
                            <field name="salario_minimo_nacional"/>
                        </setting>
                        <setting string="Ley de Protección de Pensiones (%)" help="Porcentaje de aporte patronal para SENIAT (Mayo 2024).">
                            <field name="ley_pensiones_rate"/>
                        </setting>
                        <setting string="Banco Predeterminado" help="Banco predeterminado para disquetes masivos.">
                            <field name="bank_code_default"/>
                        </setting>
                    </block>
                    <block title="Motor de Inteligencia Artificial (Nubelco AI SuperBrain)">
                        <setting string="Proveedor LLM / IA" help="Seleccione el proveedor de Inteligencia Artificial para consultas laborales.">
                            <field name="ai_provider"/>
                        </setting>
                        <setting string="Modo Simulación / Pruebas" help="Ejecuta la IA en modo borrador y trazabilidad sin activar acciones directas.">
                            <field name="ai_simulation_mode"/>
                        </setting>
                        <setting string="Clave API (API Key)" help="Clave secreta para autenticación con el proveedor LLM." invisible="ai_provider == 'heuristic_fallback'">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                        <setting string="URL Base de la API" help="Endpoint base del proveedor o servidor local Ollama." invisible="ai_provider == 'heuristic_fallback'">
                            <field name="ai_base_url"/>
                        </setting>
                        <setting string="Modelo LLM / Motor" help="Nombre del modelo (ej: deepseek-chat, gpt-4o-mini, claude-3-5-sonnet)." invisible="ai_provider == 'heuristic_fallback'">
                            <field name="ai_model_name"/>
                        </setting>
                        <setting string="Temperatura" help="Nivel de precisión (0.0 a 1.0)." invisible="ai_provider == 'heuristic_fallback'">
                            <field name="ai_temperature"/>
                        </setting>
                        <setting string="RAG Legal LOTTT" help="Indexación de artículos de la LOTTT en respuestas.">
                            <field name="ai_rag_enabled"/>
                        </setting>
                        <setting string="Herramientas ORM (Function Calling)" help="Permitir a la IA consultar expedientes y contratos en Odoo.">
                            <field name="ai_tools_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
