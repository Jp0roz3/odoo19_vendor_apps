<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_kanban_dual_currency" model="ir.ui.view">
        <field name="name">pos.config.kanban.dual_currency</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
        <field name="arch" type="xml">
            <!--
                Reemplazar la fila "Balance" del Kanban.
                Cuando show_dual_currency está activo, muestra:
                  - El monto USD en color normal (azul/oscuro)
                  - El monto Bs.F en ROJO con separador |
                Cuando show_dual_currency está inactivo, muestra el cierre normal de Odoo.
            -->
            <xpath expr="//div[hasclass('row') and div/span[text()='Balance']]" position="replace">
                <div t-if="record.last_session_closing_date.value" invisible="not cash_control" class="row">
                    <div class="col-6">
                        <span>Balance</span>
                    </div>
                    <div class="col-6">
                        <!-- Doble moneda: USD en normal, Bs.F en rojo -->
                        <t t-if="record.show_dual_currency.raw_value and record.last_session_usd_str.raw_value">
                            <div class="d-flex text-end justify-content-end align-items-center">
                                <span class="fw-bold" style="white-space: nowrap;">
                                    <t t-esc="record.last_session_bs_str.value"/>
                                </span>
                                <span class="fw-bold" style="color: #dc2626; margin-left: 4px; margin-right: 4px;"> | </span>
                                <span class="fw-bold" style="color: #dc2626; white-space: nowrap;">
                                    <t t-esc="record.last_session_usd_str.value"/>
                                </span>
                            </div>
                        </t>
                        <!-- Fallback: moneda única estándar -->
                        <t t-else="">
                            <span><field name="last_session_closing_cash" widget="monetary"/></span>
                        </t>
                    </div>
                </div>
            </xpath>

            <!-- Añadir campos computados al contexto del Kanban (Nivel raíz de kanban) -->
            <xpath expr="//field[@name='statistics_for_current_session']" position="after">
                <field name="show_dual_currency"/>
                <field name="last_session_dual_balance_str"/>
                <field name="last_session_usd_str"/>
                <field name="last_session_bs_str"/>
                <field name="fiscal_printer_active"/>
            </xpath>

            <!-- Añadir el enlace Opciones de Impresora en el título de la tarjeta -->
            <xpath expr="//div[@name='card_title']" position="inside">
                <t t-if="record.fiscal_printer_active.raw_value">
                    <div class="mt-2 mb-2">
                        <a name="%(action_pos_printer_options)d" type="action" class="fw-bold" style="color: #007bff; text-decoration: none;">
                            Opciones de Impresora
                        </a>
                    </div>
                </t>
            </xpath>

            <!-- Reemplazar el Opening balance cuando la sesión está abierta (Odoo 19) -->
            <xpath expr="//span[@name='opening_cash']" position="replace">
                <span name="opening_cash" class="col-7">
                    <t t-if="record.show_dual_currency.raw_value and statistics.cash.opening_cash_dual">
                        <span class="fw-bold" style="white-space: nowrap;"><t t-esc="statistics.cash.opening_cash_bs"/></span>
                        <span class="fw-bold" style="color: #dc2626; margin-left: 4px; margin-right: 4px;"> | </span>
                        <span class="fw-bold" style="color: #dc2626; white-space: nowrap;"><t t-esc="statistics.cash.opening_cash_usd"/></span>
                    </t>
                    <t t-else="">
                        <t t-esc="statistics.cash.opening_cash"/>
                    </t>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
