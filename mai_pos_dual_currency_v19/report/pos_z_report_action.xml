<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Paperformat for Z Report -->
        <record id="paperformat_z_report" model="report.paperformat">
            <field name="name">Paperformat Z Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">15</field>
            <field name="margin_right">15</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_z_details" model="ir.actions.report">
            <field name="name">Report Z Details</field>
            <field name="model">pos.z.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mai_pos_dual_currency_v19.report_z_details_template</field>
            <field name="report_file">mai_pos_dual_currency_v19.report_z_details_template</field>
            <field name="print_report_name">'Reporte_Z_Conciliacion'</field>
            <field name="binding_model_id" ref="model_pos_z_report_wizard"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_z_report"/>
        </record>
    </data>
</odoo>
