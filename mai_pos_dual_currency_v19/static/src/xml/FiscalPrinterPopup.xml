<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.FiscalPrinterPopup">
        <Dialog contentClass="'popup-text'">
            <t t-set-slot="header">
                <h4 class="modal-title mb-0 fw-bold">Opciones de Impresora Fiscal</h4>
            </t>
            <main class="body">
                <div class="mb-3">
                    <t t-if="!fiscalPrinter.state.isConnected">
                        <div class="alert alert-warning text-center" role="alert">
                            <i class="fa fa-exclamation-triangle"></i> La impresora fiscal no está conectada.
                        </div>
                        <button class="btn btn-primary w-100 py-3 mb-3 fw-bold" t-on-click="connectPrinter">
                            <i class="fa fa-usb"></i> Conectar por Web Serial API
                        </button>
                    </t>
                    <t t-else="">
                        <div class="alert alert-success text-center" role="alert">
                            <i class="fa fa-check-circle"></i> Máquina Conectada y lista (Driver: <t t-esc="fiscalPrinter.state.driver"/>)
                        </div>
                        <button class="btn btn-danger w-100 py-3 mb-3 fw-bold" t-on-click="disconnectPrinter">
                            <i class="fa fa-unlink"></i> Desconectar Impresora
                        </button>
                    </t>
                </div>
                
                <div class="border p-3 rounded" style="background: #f8f9fa;">
                    <h5 class="mb-3">Reportes y Control Fiscal</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <button class="btn btn-info flex-grow-1 me-2 py-3 fw-bold" t-on-click="printXReport" t-att-disabled="!fiscalPrinter.state.isConnected">
                            <i class="fa fa-print"></i> Imprimir Reporte X
                        </button>
                        <button class="btn btn-danger flex-grow-1 ms-2 py-3 fw-bold" t-on-click="printZReport" t-att-disabled="!fiscalPrinter.state.isConnected">
                            <i class="fa fa-print"></i> Imprimir Reporte Z
                        </button>
                    </div>
                    <button class="btn btn-warning w-100 py-2 fw-bold" t-on-click="cancelOpenDocument" t-att-disabled="!fiscalPrinter.state.isConnected">
                        <i class="fa fa-ban"></i> Anular / Desbloquear Documento Atascado
                    </button>
                </div>
            </main>
            <t t-set-slot="footer">
                <button class="btn btn-secondary cancel" t-on-click="props.close">
                    Cerrar
                </button>
            </t>
        </Dialog>
    </t>
</templates>
