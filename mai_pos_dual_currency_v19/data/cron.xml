<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_sync_bcv_rate" model="ir.cron">
            <field name="name">POS: Sincronización Automática Tasa BCV</field>
            <field name="model_id" ref="point_of_sale.model_pos_config"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_bcv_rate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Ejecutar a las 6:30 AM Venezuela (10:30 UTC) -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
