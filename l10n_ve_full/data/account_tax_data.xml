<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ================================================================
         Venezuela360: Impuestos SENIAT Venezuela (account.tax)
         Impuestos oficiales IVA, Exentos, Suntuario y Retenciones
    ================================================================ -->

    <!-- IVA General 16% Venta -->
    <record id="tax_iva_ven_16" model="account.tax">
        <field name="name">IVA 16% (Venta)</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">16.0</field>
        <field name="description">IVA 16%</field>
        <field name="tax_group_id" ref="tax_group_iva_general"/>
        <field name="sequence">1</field>
        <field name="active">True</field>
    </record>

    <!-- IVA General 16% Compra -->
    <record id="tax_iva_com_16" model="account.tax">
        <field name="name">IVA 16% (Compra)</field>
        <field name="type_tax_use">purchase</field>
        <field name="amount_type">percent</field>
        <field name="amount">16.0</field>
        <field name="description">IVA 16%</field>
        <field name="tax_group_id" ref="tax_group_iva_general"/>
        <field name="sequence">1</field>
        <field name="active">True</field>
    </record>

