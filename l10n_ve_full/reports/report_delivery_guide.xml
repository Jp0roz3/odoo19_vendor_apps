<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla de Guía de Despacho Fiscal SENIAT (Providencia 00071) -->
    <template id="report_delivery_guide_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <div class="page" style="font-family: Arial, sans-serif; font-size: 13px;">
                <!-- Encabezado -->
                <div class="row pb-3 mb-3 border-bottom">
                    <div class="col-7">
                        <h3 class="fw-bold mb-1" t-field="doc.company_id.name"/>
                        <p class="mb-0"><strong>RIF:</strong> <span t-field="doc.company_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><span t-field="doc.company_id.street"/></p>
                        <p class="mb-0"><strong>Tel:</strong> <span t-field="doc.company_id.phone"/></p>
                    </div>
                    <div class="col-5 text-end">
                        <div class="p-2 border border-2 border-danger rounded bg-light">
                            <h4 class="text-danger fw-bold mb-1">GUÍA DE DESPACHO</h4>
                            <p class="mb-1"><strong>N° Guía:</strong> <span t-field="doc.name"/></p>
                            <p class="mb-1 text-danger fw-bold"><strong>N° de Control:</strong> <span t-field="doc.l10n_ve_control_number"/></p>
                            <p class="mb-0"><strong>Fecha de Traslado:</strong> <span t-field="doc.scheduled_date"/></p>
                        </div>
                    </div>
                </div>

                <!-- Datos del Destinatario y Transporte -->
                <div class="row p-2 mb-3 bg-light rounded border">
                    <div class="col-6 border-end">
                        <h6 class="fw-bold border-bottom pb-1 text-primary">DESTINATARIO</h6>
                        <p class="mb-1"><strong>Razón Social:</strong> <span t-field="doc.partner_id.name"/></p>
                        <p class="mb-1"><strong>RIF / C.I.:</strong> <span t-field="doc.partner_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><strong>Dirección de Entrega:</strong> <span t-field="doc.partner_id.street"/></p>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold border-bottom pb-1 text-primary">DATOS DEL TRANSPORTE</h6>
                        <p class="mb-1"><strong>Conductor:</strong> <span t-field="doc.l10n_ve_driver_name"/> (C.I. <span t-field="doc.l10n_ve_driver_vat"/>)</p>
                        <p class="mb-1"><strong>Vehículo / Placa:</strong> <span t-field="doc.l10n_ve_vehicle_model"/> - <span t-field="doc.l10n_ve_vehicle_plate"/></p>
                        <p class="mb-0"><strong>Motivo:</strong> <span t-field="doc.l10n_ve_transport_reason"/></p>
                    </div>
                </div>

                <!-- Tabla de Mercancía Transportada -->
                <table class="table table-sm table-bordered align-middle mb-4">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Ítem</th>
                            <th>Código</th>
                            <th>Descripción de la Mercancía</th>
                            <th>Cantidad</th>
                            <th>Unidad de Medida</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.move_ids_without_package" t-as="move">
                            <td class="text-center"><span t-esc="move_index + 1"/></td>
                            <td><span t-field="move.product_id.default_code"/></td>
                            <td><span t-field="move.product_id.name"/></td>
                            <td class="text-center fw-bold"><span t-field="move.quantity"/></td>
                            <td class="text-center"><span t-field="move.product_uom.name"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Firmas de Conformidad -->
                <div class="row pt-5 mt-4 text-center">
                    <div class="col-4">
                        <div class="border-top pt-2">
                            <strong>Despachado por:</strong><br/>
                            <span class="text-muted small">Firma y Sello Almacén</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border-top pt-2">
                            <strong>Transportado por:</strong><br/>
                            <span class="text-muted small">Firma del Transportista</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border-top pt-2">
                            <strong>Recibido Conforme:</strong><br/>
                            <span class="text-muted small">Firma y Sello Cliente</span>
                        </div>
                    </div>
                </div>

                <!-- Pie Legal -->
                <div class="row pt-4 text-muted small text-center">
                    <div class="col-12">
                        <p class="mb-0">Guía emitida conforme al artículo 38 de la Providencia Administrativa SENIAT N° SNAT/2011/00071.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_delivery_guide">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="l10n_ve_full.report_delivery_guide_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_delivery_guide" model="ir.actions.report">
        <field name="name">Guía de Despacho SENIAT</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_full.report_delivery_guide</field>
        <field name="report_file">l10n_ve_full.report_delivery_guide</field>
        <field name="print_report_name">'Guia_Despacho_%s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
