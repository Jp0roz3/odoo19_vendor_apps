<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla Comprobante Anual de Retenciones de ISLR (AR-CV) -->
    <template id="report_arcv_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="docs[0] if docs else False" />
            <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;" t-if="doc">
                <!-- Encabezado AR-CV -->
                <div class="text-center pb-2 mb-3 border-bottom">
                    <h4 class="fw-bold mb-1">COMPROBANTE DE RETENCIÓN ANUAL DE I.S.L.R. (AR-CV)</h4>
                    <p class="text-muted small mb-0">(Artículo 24 del Reglamento Parcial de la Ley de Impuesto Sobre la Renta en Materia de Retenciones)</p>
                </div>

                <!-- Datos del Agente de Retención y Beneficiario -->
                <div class="row p-2 mb-3 bg-light rounded border">
                    <div class="col-6 border-end">
                        <h6 class="fw-bold border-bottom pb-1 text-primary">AGENTE DE RETENCIÓN</h6>
                        <p class="mb-1"><strong>Razón Social:</strong> <span t-field="doc.company_id.name"/></p>
                        <p class="mb-1"><strong>RIF:</strong> <span t-field="doc.company_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><strong>Dirección:</strong> <span t-field="doc.company_id.street"/></p>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold border-bottom pb-1 text-primary">SUJETO RETENIDO (BENEFICIARIO)</h6>
                        <p class="mb-1"><strong>Nombre / Razón Social:</strong> <span t-field="doc.partner_id.name"/></p>
                        <p class="mb-1"><strong>RIF / C.I.:</strong> <span t-field="doc.partner_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><strong>Dirección:</strong> <span t-field="doc.partner_id.street"/></p>
                    </div>
                </div>

                <!-- Tabla de Retenciones Acumuladas -->
                <table class="table table-sm table-bordered align-middle mb-4">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>Fecha</th>
                            <th>N° Factura</th>
                            <th>N° Control</th>
                            <th>Concepto de Retención</th>
                            <th>Base Imponible (Bs)</th>
                            <th>% Ret.</th>
                            <th>Monto Retenido (Bs)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="ret">
                            <td class="text-center"><span t-field="ret.date"/></td>
                            <td class="text-center"><span t-field="ret.move_id.name"/></td>
                            <td class="text-center"><span t-field="ret.move_id.l10n_ve_control_number"/></td>
                            <td><span t-field="ret.concept_id.name"/></td>
                            <td class="text-end"><span t-field="ret.amount_untaxed_bs"/></td>
                            <td class="text-center"><span t-field="ret.rate"/>%</td>
                            <td class="text-end fw-bold"><span t-field="ret.amount_bs"/></td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">TOTAL ACUMULADO DEL EJERCICIO:</td>
                            <td class="text-end"><span t-esc="'%.2f' % sum(r.amount_untaxed_bs for r in docs)"/> Bs</td>
                            <td></td>
                            <td class="text-end text-primary"><span t-esc="'%.2f' % sum(r.amount_bs for r in docs)"/> Bs</td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Firmas -->
                <div class="row pt-5 mt-4 text-center">
                    <div class="col-6">
                        <div class="border-top pt-2 mx-4">
                            <strong>Agente de Retención</strong><br/>
                            <span class="text-muted small">Firma y Sello Autorizado</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border-top pt-2 mx-4">
                            <strong>Beneficiario / Sujeto Retenido</strong><br/>
                            <span class="text-muted small">Firma y Cédula de Identidad</span>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_arcv">
        <t t-call="web.html_container">
            <t t-call="l10n_ve_full.report_arcv_document"/>
        </t>
    </template>

    <record id="action_report_arcv" model="ir.actions.report">
        <field name="name">Comprobante Anual AR-CV</field>
        <field name="model">account.wh.islr</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_full.report_arcv</field>
        <field name="report_file">l10n_ve_full.report_arcv</field>
        <field name="print_report_name">'ARCV_%s' % (object.partner_id.name or '')</field>
    </record>
</odoo>
