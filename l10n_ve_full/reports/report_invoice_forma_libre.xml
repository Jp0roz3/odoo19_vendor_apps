<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla de Factura Legal Forma Libre con Número de Control y Totales Duales (USD y Bs.F) -->
    <template id="report_invoice_forma_libre_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <div class="page" style="font-family: Arial, sans-serif; font-size: 13px;">
                <!-- Encabezado de Factura -->
                <div class="row pb-3 mb-3 border-bottom">
                    <div class="col-7">
                        <h3 class="fw-bold mb-1" t-field="doc.company_id.name"/>
                        <p class="mb-0"><strong>RIF:</strong> <span t-field="doc.company_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><span t-field="doc.company_id.street"/></p>
                        <p class="mb-0"><strong>Tel:</strong> <span t-field="doc.company_id.phone"/> | <strong>Email:</strong> <span t-field="doc.company_id.email"/></p>
                    </div>
                    <div class="col-5 text-end">
                        <div class="p-2 border border-2 border-primary rounded bg-light">
                            <h4 class="text-primary fw-bold mb-1">FACTURA</h4>
                            <p class="mb-1"><strong>N° Factura:</strong> <span t-field="doc.name"/></p>
                            <p class="mb-1 text-danger fw-bold"><strong>N° de Control:</strong> <span t-field="doc.l10n_ve_control_number"/></p>
                            <p class="mb-0"><strong>Fecha de Emisión:</strong> <span t-field="doc.invoice_date"/></p>
                        </div>
                    </div>
                </div>

                <!-- Datos del Cliente / Comprador -->
                <div class="row p-2 mb-3 bg-light rounded border">
                    <div class="col-7">
                        <p class="mb-1"><strong>Razón Social:</strong> <span t-field="doc.partner_id.name"/></p>
                        <p class="mb-1"><strong>RIF / C.I.:</strong> <span t-field="doc.partner_id.l10n_ve_rif"/></p>
                        <p class="mb-0"><strong>Dirección Fiscal:</strong> <span t-field="doc.partner_id.street"/></p>
                    </div>
                    <div class="col-5">
                        <p class="mb-1"><strong>Teléfono:</strong> <span t-field="doc.partner_id.phone"/></p>
                        <p class="mb-1"><strong>Tasa BCV Aplicada:</strong> <span t-field="doc.l10n_ve_rate_applied"/> Bs/$</p>
                        <p class="mb-0"><strong>Condición de Pago:</strong> <span t-field="doc.invoice_payment_term_id.name"/></p>
                    </div>
                </div>

                <!-- Tabla de Productos / Servicios -->
                <table class="table table-sm table-striped align-middle mb-4">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Cant.</th>
                            <th>Precio Unit ($)</th>
                            <th>Precio Unit (Bs)</th>
                            <th>IVA %</th>
                            <th>Subtotal ($)</th>
                            <th>Subtotal (Bs)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.invoice_line_ids" t-as="line">
                            <td><span t-field="line.product_id.default_code"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-center"><span t-field="line.quantity"/></td>
                            <td class="text-end">$ <span t-esc="'%.2f' % line.price_unit"/></td>
                            <td class="text-end"><span t-esc="'%.2f' % (line.price_unit * doc.l10n_ve_rate_applied)"/> Bs</td>
                            <td class="text-center"><span t-esc="', '.join(map(lambda x: x.name, line.tax_ids))"/></td>
                            <td class="text-end fw-bold">$ <span t-field="line.price_subtotal"/></td>
                            <td class="text-end fw-bold"><span t-esc="'%.2f' % (line.price_subtotal * doc.l10n_ve_rate_applied)"/> Bs</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totales Bimoneda Duales en Cuadro Paralelo -->
                <div class="row justify-content-end mb-4">
                    <div class="col-5">
                        <div class="p-3 border border-dark rounded bg-light">
                            <h5 class="fw-bold text-center border-bottom pb-2 mb-2">TOTALES FISCALES DUALES</h5>
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td><strong>Base Imponible:</strong></td>
                                    <td class="text-end">$ <span t-field="doc.amount_untaxed"/></td>
                                    <td class="text-end"><span t-field="doc.l10n_ve_amount_untaxed_bs"/></td>
                                </tr>
                                <tr>
                                    <td><strong>IVA Total:</strong></td>
                                    <td class="text-end">$ <span t-field="doc.amount_tax"/></td>
                                    <td class="text-end"><span t-field="doc.l10n_ve_amount_tax_bs"/></td>
                                </tr>
                                <tr class="border-top border-2">
                                    <td><strong class="fs-6">TOTAL GENERAL:</strong></td>
                                    <td class="text-end fw-bold fs-6 text-primary">$ <span t-field="doc.amount_total"/></td>
                                    <td class="text-end fw-bold fs-6 text-primary"><span t-field="doc.l10n_ve_amount_total_bs"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Pie de Imprenta Autorizada SENIAT -->
                <div class="row pt-3 border-top text-muted small text-center">
                    <div class="col-12">
                        <p class="mb-0">Documento emitido conforme a la Providencia Administrativa SENIAT N° SNAT/2011/00071.</p>
                        <p class="mb-0">Los montos en Bolívares han sido calculados a la tasa oficial del Banco Central de Venezuela de fecha <span t-field="doc.l10n_ve_rate_date"/>.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_invoice_forma_libre">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="l10n_ve_full.report_invoice_forma_libre_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_invoice_forma_libre" model="ir.actions.report">
        <field name="name">Factura Legal / Forma Libre (SENIAT)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_full.report_invoice_forma_libre</field>
        <field name="report_file">l10n_ve_full.report_invoice_forma_libre</field>
        <field name="print_report_name">'Factura_Forma_Libre_%s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
