<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extensión OWL del Panel de Control de Reportes Contables en Odoo Enterprise -->
    <t t-name="l10n_ve_full.AccountReportControlPanel" t-inherit="account_reports.AccountReportControlPanel" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_account_reports_filter_input_wrapper') or hasclass('d-flex') or hasclass('btn-group')][last()]" position="after">
            <div t-if="controller.options and controller.options.filter_l10n_ve_currency" class="btn-group dropdown ms-1 me-1 l10n_ve_currency_filter_group">
                <button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" type="button">
                    <i class="fa fa-money me-1"/>Moneda: 
                    <span style="color: #dc3545; font-weight: bold;">
                        <t t-out="controller.options.l10n_ve_currency_label or 'Bs.F'"/>
                    </span>
                </button>
                <ul class="dropdown-menu shadow">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="#" t-on-click.prevent="() => this.setL10nVeCurrency('bs')">
                            <i t-if="controller.options.l10n_ve_currency != 'usd'" class="fa fa-check text-primary me-1"/>
                            <i t-else="" class="fa fa-fw me-1"/>
                            <span>Bs.F</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="#" t-on-click.prevent="() => this.setL10nVeCurrency('usd')">
                            <i t-if="controller.options.l10n_ve_currency == 'usd'" class="fa fa-check text-primary me-1"/>
                            <i t-else="" class="fa fa-fw me-1"/>
                            <span>$</span>
                        </a>
                    </li>
                </ul>
            </div>
            <span t-if="controller.options and controller.options.l10n_ve_badge_label"
                  class="badge rounded-pill align-self-center ms-1 me-1 l10n_ve_currency_badge"
                  style="background-color: #f1f3f5; color: #495057; font-weight: 600; padding: 6px 10px; font-size: 12px; border: 1px solid #ced4da;">
                <t t-out="controller.options.l10n_ve_badge_label"/>
            </span>
        </xpath>
    </t>

</templates>
