<templates xml:space="preserve">
    <t t-name="l10n_ve_full.BcvRateSystray">
        <!-- Indicador de Tasa USD / BCV en la barra superior con el formato exacto de la referencia -->
        <div class="o_bcv_rate_systray d-flex align-items-center me-2 text-nowrap"
             title="Tasa de Cambio Oficial (USD/Bs.) · Clic para sincronizar"
             style="cursor: pointer; font-size: 0.88rem; gap: 5px; padding: 2px 6px; user-select: none;"
             t-on-click="onClickSync">

            <!-- Icono de herramientas como en la imagen de referencia -->
            <i class="fa fa-wrench" style="font-size: 0.95rem; opacity: 0.85;"/>

            <!-- Formato exacto: USD: XXX.XXXX en negrita -->
            <span t-if="isLoaded" class="fw-bold" style="letter-spacing: 0.3px;">
                USD: <t t-out="state.rate"/>
            </span>

            <!-- Estado: cargando / sincronizando -->
            <span t-if="state.loading" class="small opacity-75">
                <i class="fa fa-spinner fa-spin me-1"/>
            </span>

            <!-- Estado: error / sin datos -->
            <span t-if="hasError" class="text-danger small fw-bold" title="Sin tasa registrada">
                USD: ---
            </span>
        </div>
    </t>
</templates>
