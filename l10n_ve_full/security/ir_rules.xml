<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Reglas de Registro Multi-Compañía
         Cada empresa solo ve su propia data fiscal.
    ================================================================ -->

    <!-- Tasas BCV: solo ve su compañía -->
    <record id="rule_exchange_rate_company" model="ir.rule">
        <field name="name">Tasa BCV: Solo propia compañía</field>
        <field name="model_id" ref="model_l10n_ve_exchange_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_l10n_ve_user'))]"/>
    </record>

    <!-- UT histórica: solo ve su compañía -->
    <record id="rule_ut_history_company" model="ir.rule">
