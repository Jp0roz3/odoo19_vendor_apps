<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Formulario y Lista de Libro Fiscal (Compra y Venta)
        ==================================================================
        Coincidencia visual exacta con las Imágenes 1 y 2 de referencia:
          - Botones: [ACTUALIZAR LIBRO] [BORRAR LIBRO] [IMPRIMIR LIBRO] [CONFIRMAR] [IMPRIMIR RESUMIDO]
          - Statusbar: Preparándose -> Aprobado por el Responsable -> Enviado al Seniat
          - Pestañas: [Lineas de Libro Fiscal] [Facturas Libro Fiscal] [Libro de Impuestos Fiscales] [Libro Fiscal Retenciones de IVA] [Resumen]
    -->

    <!-- Lista de Libros Fiscales -->
    <record id="view_account_fiscal_book_list" model="ir.ui.view">
        <field name="name">account.fiscal.book.list</field>
        <field name="model">account.fiscal.book</field>
        <field name="arch" type="xml">
            <list string="Libros Fiscales"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'approved'"
                  decoration-muted="state == 'cancel'">
                <field name="name" string="Descripción"/>
                <field name="book_type" string="Tipo de Libro" widget="badge"
                       decoration-info="book_type == 'purchase'"
                       decoration-success="book_type == 'sale'"/>
                <field name="date_from" string="Fecha Inicio"/>
                <field name="date_to" string="Fecha Fin"/>
                <field name="line_count" string="Documentos"/>
                <field name="total_amount_bs" string="Total con IVA (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_base_bs" string="Base Imponible (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_iva_bs" string="IVA (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_wh_iva_bs" string="IVA Retenido (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="state" widget="badge"/>
                <field name="currency_bs_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Formulario de Libro Fiscal (Compra y Venta) -->
    <record id="view_account_fiscal_book_form" model="ir.ui.view">
        <field name="name">account.fiscal.book.form</field>
        <field name="model">account.fiscal.book</field>
        <field name="arch" type="xml">
            <form string="Libro Fiscal">
                <header>
                    <button name="action_generate_lines"
                            string="ACTUALIZAR LIBRO"
                            type="object" class="btn-primary"
                            invisible="state in ['approved', 'done', 'cancel']"/>
                    <button name="action_clear_book"
                            string="BORRAR LIBRO"
                            type="object" class="btn-secondary"
                            invisible="state in ['approved', 'done', 'cancel']"/>
                    <button name="action_print_book_wizard"
                            string="IMPRIMIR LIBRO"
                            type="object" class="btn-primary"/>
                    <button name="action_confirm"
                            string="CONFIRMAR"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_print_book_wizard"
                            string="IMPRIMIR RESUMIDO"
                            type="object" class="btn-secondary"
                            invisible="book_type != 'sale'"/>
                    <button name="action_send_seniat"
                            string="ENVIAR AL SENIAT"
                            type="object" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_set_draft"
                            string="VOLVER A BORRADOR"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2 style="color: #1e3a8a; font-weight: 800;">
                            <field name="display_name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Descripción" readonly="state != 'draft'"/>
                            <field name="book_type" string="Tipo de libro" readonly="state != 'draft'"/>
                            <field name="period_type" string="Período" readonly="state != 'draft'"/>
                            <label for="date_from" string="Rango de Fechas"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="date_from" readonly="state != 'draft'"/>
                                <span>-</span>
                                <field name="date_to" readonly="state != 'draft'"/>
                            </div>
                        </group>
                        <group>
                            <field name="journal_ids" string="Diarios" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="company_id" string="Compañía" groups="base.group_multi_company"/>
                            <field name="line_count" string="Documentos Procesados" readonly="1"/>
                        </group>
                    </group>

                    <!-- Pestañas oficiales idénticas a las imágenes -->
                    <notebook>
                        <!-- Pestaña 1: Líneas de Libro Fiscal -->
                        <page string="Lineas de Libro Fiscal" name="fiscal_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Líneas del Libro" create="false" delete="false">
                                    <field name="line_no" string="Line"/>
                                    <field name="doc_type" string="Tipo de D..."/>
                                    <field name="date" string="Fecha de ..."/>
                                    <field name="control_number" string="Nro de Co..."/>
                                    <field name="invoice_number" string="Nro de Fa..."/>
                                    <field name="affected_invoice" string="Factura Af..."/>
                                    <field name="partner_name" string="Nombre d..."/>
                                    <field name="rif" string="Nro. RIF"/>
                                    <field name="partner_type" string="Tipo de Pe..."/>
                                    <field name="transaction_type" string="Tipo de Tr..."/>
                                    <field name="total_amount_bs" string="Total con IVA" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="sdcf_bs" string="SDCF" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="exempt_bs" string="Exento" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="base_general_bs" string="Base (16%)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="iva_general_bs" string="IVA (16%)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="wh_voucher_number" string="Comprobante"/>
                                    <field name="wh_amount_bs" string="IVA Retenido" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="currency_bs_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Pestaña 2: Facturas Libro Fiscal -->
                        <page string="Facturas Libro Fiscal" name="invoices_tab">
                            <group string="Resumen de Documentos Fiscales">
                                <field name="line_count" string="Total de Facturas / Notas"/>
                                <field name="total_amount_bs" string="Monto Total Bruto (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            </group>
                        </page>

                        <!-- Pestaña 3: Libro de Impuestos Fiscales -->
                        <page string="Libro de Impuestos Fiscales" name="taxes_tab">
                            <group>
                                <group string="Alícuota General (16%)">
                                    <field name="total_base_bs" string="Base Imponible General" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_iva_bs" string="Débito/Crédito IVA 16%" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                </group>
                                <group string="Operaciones Exentas y No Sujetas">
                                    <field name="total_exempt_bs" string="Total Exento" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_sdcf_bs" string="Total SDCF" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_igtf_bs" string="Total IGTF 3%" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                </group>
                            </group>
                        </page>

                        <!-- Pestaña 4: Libro Fiscal Retenciones de IVA -->
                        <page string="Libro Fiscal Retenciones de IVA" name="retentions_tab">
                            <group string="Retenciones de IVA del Período">
                                <field name="total_wh_iva_bs" string="Total IVA Retenido" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            </group>
                        </page>

                        <!-- Pestaña 5: Resumen -->
                        <page string="Resumen" name="summary_tab">
                            <group>
                                <group string="Totales Consolidados">
                                    <field name="total_amount_bs" string="Total Operaciones (Bs)" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_base_bs" string="Base Imponible Total" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_iva_bs" string="Impuesto IVA Total" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_wh_iva_bs" string="Total Retención IVA" widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Acciones de Ventana para Libros Fiscales -->
    <record id="action_fiscal_book_purchase" model="ir.actions.act_window">
        <field name="name">Libro Fiscal de Compra</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type', '=', 'purchase')]</field>
        <field name="context">{'default_book_type': 'purchase'}</field>
    </record>

    <record id="action_account_fiscal_book_purchase" model="ir.actions.act_window">
        <field name="name">Libro Fiscal de Compra</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type', '=', 'purchase')]</field>
        <field name="context">{'default_book_type': 'purchase'}</field>
    </record>

    <record id="action_fiscal_book_sale" model="ir.actions.act_window">
        <field name="name">Libro Fiscal de Venta</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type', '=', 'sale')]</field>
        <field name="context">{'default_book_type': 'sale'}</field>
    </record>

    <record id="action_account_fiscal_book_sale" model="ir.actions.act_window">
        <field name="name">Libro Fiscal de Venta</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type', '=', 'sale')]</field>
        <field name="context">{'default_book_type': 'sale'}</field>
    </record>

    <record id="action_account_fiscal_book" model="ir.actions.act_window">
        <field name="name">Libros Fiscales</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
