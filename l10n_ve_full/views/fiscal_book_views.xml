<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Vistas — Libros Fiscales
    ================================================================ -->

    <!-- Lista de libros -->
    <record id="view_account_fiscal_book_list" model="ir.ui.view">
        <field name="name">account.fiscal.book.list</field>
        <field name="model">account.fiscal.book</field>
        <field name="arch" type="xml">
            <list string="Libros Fiscales"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="book_type" widget="badge"
                       decoration-info="book_type == 'purchase'"
                       decoration-success="book_type == 'sale'"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="line_count" string="Documentos"/>
                <field name="total_base_bs" string="Base Imp. (Bs)"
                       widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_iva_bs" string="IVA (Bs)"
                       widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_amount_bs" string="Total (Bs)"
                       widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                <field name="total_amount_usd" string="Total (USD)"/>
                <field name="state" widget="badge"/>
                <field name="currency_bs_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Formulario de libro fiscal -->
    <record id="view_account_fiscal_book_form" model="ir.ui.view">
        <field name="name">account.fiscal.book.form</field>
        <field name="model">account.fiscal.book</field>
        <field name="arch" type="xml">
            <form string="Libro Fiscal">
                <header>
                    <button name="action_generate_lines"
                            string="Generar / Actualizar Líneas"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close_book"
                            string="Cerrar Libro"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel"
                            string="Anular"
                            type="object"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                        <h2><field name="display_name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Período">
                            <field name="book_type" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to"   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Totales del Período">
                            <field name="line_count" readonly="1"/>
                            <field name="total_base_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="total_iva_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="total_wh_iva_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="total_wh_islr_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="total_amount_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="total_base_usd"   readonly="1"/>
                            <field name="total_amount_usd" readonly="1"/>
                        </group>
                    </group>
                    <!-- Líneas detalladas del libro -->
                    <notebook>
                        <page string="Detalle de Documentos" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Líneas del Libro">
                                    <field name="date"/>
                                    <field name="partner_id" string="Proveedor/Cliente"/>
                                    <field name="rif"/>
                                    <field name="fiscal_number" string="N° Fiscal"/>
                                    <field name="control_number" string="N° Control"/>
                                    <field name="rate" string="Tasa BCV" digits="[18,4]"/>
                                    <field name="base_bs" string="Base (Bs)"
                                           widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="iva_bs" string="IVA (Bs)"
                                           widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="wh_iva_bs" string="Ret.IVA (Bs)"
                                           widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="wh_islr_bs" string="Ret.ISLR (Bs)"
                                           widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="total_bs" string="Total (Bs)"
                                           widget="monetary" options="{'currency_field': 'currency_bs_id'}"/>
                                    <field name="base_usd"  string="Base (USD)"/>
                                    <field name="total_usd" string="Total (USD)"/>
                                    <field name="currency_bs_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="currency_bs_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_account_fiscal_book_search" model="ir.ui.view">
        <field name="name">account.fiscal.book.search</field>
        <field name="model">account.fiscal.book</field>
        <field name="arch" type="xml">
            <search string="Buscar Libro Fiscal">
                <field name="name"/>
                <filter name="purchase" string="Compras" domain="[('book_type','=','purchase')]"/>
                <filter name="sale"     string="Ventas"  domain="[('book_type','=','sale')]"/>
                <separator/>
                <filter name="draft"   string="Borrador"   domain="[('state','=','draft')]"/>
                <filter name="done"    string="Cerrado"    domain="[('state','=','done')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter name="group_type"    string="Tipo"     context="{'group_by':'book_type'}"/>
                    <filter name="group_period"  string="Período"  context="{'group_by':'date_from:month'}"/>
                    <filter name="group_company" string="Compañía" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_fiscal_book" model="ir.actions.act_window">
        <field name="name">Libros Fiscales</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_fiscal_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer libro fiscal del período
            </p>
            <p>Genera automáticamente el Libro de Compras o Ventas con todas las facturas del período.</p>
        </field>
    </record>

    <!-- Acción rápida: solo libro de compras -->
    <record id="action_fiscal_book_purchase" model="ir.actions.act_window">
        <field name="name">Libro de Compras</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type','=','purchase')]</field>
        <field name="context">{'default_book_type': 'purchase'}</field>
    </record>

    <!-- Acción rápida: solo libro de ventas -->
    <record id="action_fiscal_book_sale" model="ir.actions.act_window">
        <field name="name">Libro de Ventas</field>
        <field name="res_model">account.fiscal.book</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('book_type','=','sale')]</field>
        <field name="context">{'default_book_type': 'sale'}</field>
    </record>
</odoo>
