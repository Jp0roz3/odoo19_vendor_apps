<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Vistas — Unidad Tributaria Histórica
    ================================================================ -->

    <record id="view_account_ut_history_list" model="ir.ui.view">
        <field name="name">account.ut.history.list</field>
        <field name="model">account.ut.history</field>
        <field name="arch" type="xml">
            <list string="Histórico UT" default_order="date_from desc">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="value_bs" string="Valor Bs" widget="monetary"
                       options="{'currency_field': 'currency_bs_id'}"/>
                <field name="value_usd" string="Equiv. USD" digits="[12,4]"/>
                <field name="gaceta_oficial"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_bs_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_ut_history_form" model="ir.ui.view">
        <field name="name">account.ut.history.form</field>
        <field name="model">account.ut.history</field>
        <field name="arch" type="xml">
            <form string="Unidad Tributaria">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: UT 2024 — Bs 9.000,00"/></h1>
                    </div>
                    <group>
                        <group string="Vigencia y Valor">
                            <field name="date_from" string="Vigente desde"/>
                            <field name="date_to"   string="Vigente hasta (vacío = indefinido)"/>
                            <field name="value_bs"  string="Valor en Bs" widget="monetary"
                                   options="{'currency_field': 'currency_bs_id'}"/>
                            <field name="currency_bs_id"/>
                            <field name="value_usd" readonly="1"/>
                        </group>
                        <group string="Referencia Legal">
                            <field name="gaceta_oficial"/>
                            <field name="providencia"/>
                            <field name="exchange_rate_id"
                                   string="Tasa BCV usada para equiv. USD"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_ut_history" model="ir.actions.act_window">
        <field name="name">Unidad Tributaria Histórica</field>
        <field name="res_model">account.ut.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra el historial de Unidad Tributaria del SENIAT
            </p>
        </field>
    </record>
</odoo>
