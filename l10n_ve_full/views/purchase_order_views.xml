<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión del Formulario de Pedidos de Compra (purchase.order) -->
    <record id="purchase_order_form_l10n_ve_dual" model="ir.ui.view">
        <field name="name">purchase.order.form.l10n_ve.dual</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Selector de Tipo de Tasa en Encabezado (Requerimiento 1) -->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="l10n_ve_rate_type" widget="radio" options="{'horizontal': true}" readonly="state not in ('draft', 'sent')"/>
                <field name="l10n_ve_rate_applied" string="Tasa Aplicada (Bs/USD)" digits="[18, 6]" readonly="l10n_ve_rate_type == 'bcv' or state not in ('draft', 'sent')"/>
            </xpath>

            <!-- Totales Referenciales en Bolívares al lado izquierdo de los totales en Dólares -->
            <xpath expr="//field[@name='tax_totals']/parent::group" position="before">
                <group class="oe_subtotal_footer" invisible="not l10n_ve_is_usd_order">
                    <field name="l10n_ve_untaxed_bs" string="Base imponible Bs." readonly="1"/>
                    <field name="l10n_ve_tax_bs" string="Impuestos Bs." readonly="1"/>
                    <field name="l10n_ve_total_bs" string="Total Bs." readonly="1" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
