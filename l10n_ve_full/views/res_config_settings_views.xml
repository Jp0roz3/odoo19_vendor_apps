<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
         Venezuela360: Configuración de la Compañía — Extensión Settings Odoo 17
         Hereda de account.res_config_settings_view_form con xpath correcto para Odoo 17.
    -->
    <record id="view_res_config_settings_l10n_ve" model="ir.ui.view">
        <field name="name">res.config.settings.l10n_ve</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- En Odoo 17, la estructura de settings usa divs con clases.
                 Insertamos nuestro bloque al final del form, antes del cierre. -->
            <xpath expr="//div[hasclass('app_settings_block')]" position="after">
                <div class="app_settings_block" id="l10n_ve_settings"
                     data-string="Venezuela360"
                     data-key="l10n_ve_full">

                    <h2>Venezuela360 — Localización Fiscal Venezuela</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l10n_ve_active"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_active"
                                       string="Activar Localización Venezuela360"/>
                                <div class="text-muted">
                                    Habilita RIF, retenciones IVA/ISLR/Municipal,
                                    libros fiscales y doble moneda BS/USD.
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box"
                             attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="l10n_ve_dual_currency"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_dual_currency"
                                       string="Contabilidad Dual BS/USD"/>
                                <div class="text-muted">
                                    Muestra montos en Bs y USD en todos los documentos.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Identificación Fiscal"/>
                                <field name="l10n_ve_rif" placeholder="J-12345678-9"/>
                                <field name="l10n_ve_contributor_type"/>
                                <div class="mt4"/>
                                <label string="Agentes de Retención"/>
                                <field name="l10n_ve_retention_agent"
                                       string="Agente de Retención IVA"/>
                                <field name="l10n_ve_retention_islr_agent"
                                       string="Agente de Retención ISLR"/>
                                <div class="mt4"/>
                                <label string="Fuente Tasa BCV"/>
                                <field name="l10n_ve_rate_source"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Tasas IVA Configuradas"/>
                                <field name="l10n_ve_iva_rate" string="IVA General (%)"/>
                                <field name="l10n_ve_iva_reduced_rate" string="IVA Reducida (%)"/>
                                <field name="l10n_ve_wh_iva_rate_general"
                                       string="Ret. IVA Ordinario (%)"/>
                                <field name="l10n_ve_wh_iva_rate_special"
                                       string="Ret. IVA Especial (%)"/>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Diarios Contables"/>
                                <field name="l10n_ve_wh_iva_journal_id"
                                       string="Diario Ret. IVA"/>
                                <field name="l10n_ve_wh_islr_journal_id"
                                       string="Diario Ret. ISLR"/>
                                <field name="l10n_ve_wh_municipal_journal_id"
                                       string="Diario Ret. Municipal"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Cuentas Contables de Retención"/>
                                <field name="l10n_ve_wh_iva_account_id"
                                       string="IVA Retenido (emitido)"/>
                                <field name="l10n_ve_wh_iva_received_account_id"
                                       string="IVA Retenido (recibido)"/>
                                <field name="l10n_ve_wh_islr_account_id"
                                       string="ISLR Retenido"/>
                                <field name="l10n_ve_wh_municipal_account_id"
                                       string="Ret. Municipal"/>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>
</odoo>
