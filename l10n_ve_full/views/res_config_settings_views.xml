<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Configuración de la Compañía
         Extiende res.config.settings con pestaña Venezuela360
    ================================================================ -->
    <record id="view_res_config_settings_l10n_ve" model="ir.ui.view">
        <field name="name">res.config.settings.l10n_ve</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="before">
                <div class="app_settings_block" data-string="Venezuela360"
                     id="l10n_ve_settings" data-key="l10n_ve_full">
                    <h2>Venezuela360 — Localización Fiscal</h2>

                    <div class="row mt16 o_settings_container" id="l10n_ve_general">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="l10n_ve_active"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_active" string="Activar Localización Venezuela360"/>
                                <div class="text-muted">
                                    Habilita todos los campos y funciones fiscales venezolanas
                                    (RIF, retenciones, libros, dual BS/USD).
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box"
                             attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="l10n_ve_dual_currency"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_dual_currency" string="Contabilidad Dual BS/USD"/>
                                <div class="text-muted">
                                    Muestra los montos en Bs y USD en todos los documentos y reportes.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_rif" string="RIF de la Empresa"/>
                                <field name="l10n_ve_rif" placeholder="J-12345678-9"/>
                                <field name="l10n_ve_contributor_type"/>
                                <div class="mt4"/>
                                <label for="l10n_ve_rate_source" string="Fuente de Tasa BCV"/>
                                <field name="l10n_ve_rate_source"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Agente de Retención"/>
                                <field name="l10n_ve_retention_agent"
                                       string="Agente de Retención IVA"/>
                                <field name="l10n_ve_retention_islr_agent"
                                       string="Agente de Retención ISLR"/>
                                <div class="mt4"/>
                                <label string="Tasas IVA"/>
                                <field name="l10n_ve_iva_rate" string="IVA General (%)"/>
                                <field name="l10n_ve_iva_reduced_rate" string="IVA Reducida (%)"/>
                                <field name="l10n_ve_wh_iva_rate_general" string="Ret.IVA Ordinario (%)"/>
                                <field name="l10n_ve_wh_iva_rate_special" string="Ret.IVA Especial (%)"/>
                            </div>
                        </div>
                    </div>

                    <h3 attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                        Diarios y Cuentas Contables
                    </h3>
                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': [('l10n_ve_active', '=', False)]}">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Diarios"/>
                                <field name="l10n_ve_wh_iva_journal_id"
                                       string="Diario Ret. IVA"/>
                                <field name="l10n_ve_wh_islr_journal_id"
                                       string="Diario Ret. ISLR"/>
                                <field name="l10n_ve_wh_municipal_journal_id"
                                       string="Diario Ret. Municipal"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label string="Cuentas Contables"/>
                                <field name="l10n_ve_wh_iva_account_id"
                                       string="Cuenta IVA Retenido (emitido)"/>
                                <field name="l10n_ve_wh_iva_received_account_id"
                                       string="Cuenta IVA Retenido (recibido)"/>
                                <field name="l10n_ve_wh_islr_account_id"
                                       string="Cuenta ISLR Retenido"/>
                                <field name="l10n_ve_wh_municipal_account_id"
                                       string="Cuenta Ret. Municipal"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
