<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Extensión de Factura (account.move)
         Añade pestaña "Venezuela360" en facturas con dual BS/USD,
         tasa BCV, UT, campos fiscales y stat buttons de retenciones.
    ================================================================ -->

    <!-- Stat Buttons en el encabezado de la factura -->
    <record id="view_move_form_l10n_ve_buttons" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ve.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botones stat en la barra de estado -->
            <div name="button_box" position="inside">
                <button name="action_view_wh_iva"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_iva_count"/>
                        </span>
                        <span class="o_stat_text">Ret. IVA</span>
                    </div>
                </button>
                <button name="action_view_wh_islr"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_islr_count"/>
                        </span>
                        <span class="o_stat_text">Ret. ISLR</span>
                    </div>
                </button>
                <button name="action_view_wh_municipal"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_municipal_count"/>
                        </span>
                        <span class="o_stat_text">Ret. Mun.</span>
                    </div>
                </button>
            </div>

            <!-- Pestaña Venezuela360 dentro del notebook -->
            <notebook position="inside">
                <page string="Venezuela360" name="l10n_ve"
                      invisible="not l10n_ve_localization">
                    <group>
                        <group string="Tasa BCV y Moneda Dual">
                            <field name="l10n_ve_exchange_rate_id"
                                   readonly="state == 'posted'"/>
                            <field name="l10n_ve_rate" readonly="1" string="Tasa Bs/USD"/>
                            <field name="l10n_ve_rate_date" readonly="1"/>
                            <field name="l10n_ve_rate_source" readonly="1"/>
                        </group>
                        <group string="Unidad Tributaria">
                            <field name="l10n_ve_ut_id"    readonly="1"/>
                            <field name="l10n_ve_ut_value" readonly="1" string="Valor UT (Bs)"/>
                        </group>
                    </group>
                    <group string="Montos en Bolívares (Bs)">
                        <group>
                            <field name="l10n_ve_amount_untaxed_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                            <field name="l10n_ve_amount_tax_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                            <field name="l10n_ve_amount_total_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                        </group>
                        <group string="Retenciones aplicadas (Bs)">
                            <field name="l10n_ve_wh_iva_total_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                            <field name="l10n_ve_wh_islr_total_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                            <field name="l10n_ve_wh_municipal_total_bs" readonly="1"
                                   widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                        </group>
                    </group>
                    <group string="Montos en USD">
                        <field name="l10n_ve_amount_untaxed_usd" readonly="1"/>
                        <field name="l10n_ve_amount_tax_usd"     readonly="1"/>
                        <field name="l10n_ve_amount_total_usd"   readonly="1"/>
                        <field name="l10n_ve_wh_iva_total_usd"   readonly="1"/>
                    </group>
                    <group string="Documentación Fiscal">
                        <field name="l10n_ve_fiscal_number"
                               readonly="state == 'posted'"/>
                        <field name="l10n_ve_control_number"
                               readonly="state == 'posted'"/>
                        <field name="l10n_ve_is_usd_document" invisible="1"/>
                        <field name="l10n_ve_localization" invisible="1"/>
                        <field name="l10n_ve_currency_bs_id" invisible="1"/>
                    </group>
                </page>
            </notebook>

            <!-- ── Campos de Cabecera Bimoneda (Panel Derecho) ───────────────── -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="l10n_ve_is_bs_agreement" string="Acuerdo de Factura Bs." invisible="not l10n_ve_localization"/>
                <field name="l10n_ve_dual_currency_name" string="Moneda Dual Ref." invisible="not l10n_ve_localization" readonly="1"/>
                <field name="l10n_ve_ref_currency_label" string="Moneda de Referencia" invisible="not l10n_ve_localization" readonly="1"/>
                <field name="l10n_ve_rate" string="Tasa" invisible="not l10n_ve_localization" readonly="1"/>
            </xpath>

            <!-- ── Columnas Bimoneda en Tabla de Líneas ──────────────────────── -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="l10n_ve_price_unit_usd" string="Precio $ Moneda D..." optional="show" invisible="not parent.l10n_ve_localization"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                <field name="l10n_ve_price_subtotal_usd" string="Subtotal Ref." optional="show" invisible="not parent.l10n_ve_localization"/>
            </xpath>

            <!-- ── Totales Duales de Referencia LADO IZQUIERDO HORIZONTAL (Lado a Lado con USD) ── -->
            <xpath expr="//field[@name='narration']/ancestor::group[1]" position="inside">
                <div invisible="not l10n_ve_localization" class="mt-3 pt-2 pe-4" style="max-width: 380px;">
                    <!-- Si la factura está en USD: Muestra Referencia en Bs (Lado Izquierdo) -->
                    <div invisible="not l10n_ve_is_usd_document">
                        <div class="d-flex justify-content-between py-1" style="white-space: nowrap;">
                            <span class="text-secondary fw-semibold">Base imponible Bs.:</span>
                            <span class="fw-bold ms-3 text-nowrap"><field name="l10n_ve_untaxed_bs" widget="float" digits="[18,2]" readonly="1"/> Bs.F</span>
                        </div>
                        <div class="d-flex justify-content-between py-1" style="white-space: nowrap;">
                            <span class="text-secondary fw-semibold">Impuestos Bs.:</span>
                            <span class="fw-bold ms-3 text-nowrap"><field name="l10n_ve_tax_bs" widget="float" digits="[18,2]" readonly="1"/> Bs.F</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-top mt-1 pt-1" style="white-space: nowrap;">
                            <span class="fw-bolder text-dark fs-6">Total Bs.:</span>
                            <span class="fw-bolder text-dark fs-6 ms-3 text-nowrap"><field name="l10n_ve_total_bs" widget="float" digits="[18,2]" readonly="1"/> Bs.F</span>
                        </div>
                    </div>

                    <!-- Si la factura está en Bs: Muestra Referencia en USD (Lado Izquierdo) -->
                    <div invisible="l10n_ve_is_usd_document">
                        <div class="d-flex justify-content-between py-1" style="white-space: nowrap;">
                            <span class="text-secondary fw-semibold">Base imponible Ref.:</span>
                            <span class="fw-bold ms-3 text-nowrap">$ <field name="l10n_ve_untaxed_ref" widget="float" digits="[18,2]" readonly="1"/></span>
                        </div>
                        <div class="d-flex justify-content-between py-1" style="white-space: nowrap;">
                            <span class="text-secondary fw-semibold">Impuestos Ref.:</span>
                            <span class="fw-bold ms-3 text-nowrap">$ <field name="l10n_ve_tax_ref" widget="float" digits="[18,2]" readonly="1"/></span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-top mt-1 pt-1" style="white-space: nowrap;">
                            <span class="fw-bolder text-dark fs-6">Total Ref.:</span>
                            <span class="fw-bolder text-dark fs-6 ms-3 text-nowrap">$ <field name="l10n_ve_total_ref" widget="float" digits="[18,2]" readonly="1"/></span>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
