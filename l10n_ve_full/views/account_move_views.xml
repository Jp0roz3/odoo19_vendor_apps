<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Venezuela360: Extensión de Factura (account.move)
         Añade pestaña "Venezuela360" en facturas con dual BS/USD,
         tasa BCV / Personalizada / Comercial, campos fiscales,
         botón para emisión de Notas de Débito,
         y totales bimoneda integrados: Bolívares (Izq) y Dólares (Der).
    ================================================================ -->

    <!-- Botones y Acciones en Encabezado de Factura -->
    <record id="view_move_form_l10n_ve_buttons" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ve.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Botón Nota de Débito y Generación de Retenciones al lado de Nota de Crédito -->
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button name="action_create_debit_note"
                        string="Nota de Débito"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice') or not l10n_ve_localization"/>
                <button name="action_generate_wh_iva"
                        string="Retención IVA"
                        type="object"
                        class="btn-secondary"
                        invisible="not l10n_ve_show_wh_iva_button"/>
                <button name="action_generate_wh_islr"
                        string="Retención ISLR"
                        type="object"
                        class="btn-secondary"
                        invisible="not l10n_ve_show_wh_islr_button"/>
                <button name="action_generate_wh_municipal"
                        string="Retención Municipal"
                        type="object"
                        class="btn-secondary"
                        invisible="not l10n_ve_show_wh_municipal_button"/>
            </xpath>

            <!-- Stat Buttons en la barra de estado -->
            <div name="button_box" position="inside">
                <button name="action_view_wh_iva"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_iva_count"/>
                        </span>
                        <span class="o_stat_text">Ret. IVA</span>
                    </div>
                </button>
                <button name="action_view_wh_islr"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_islr_count"/>
                        </span>
                        <span class="o_stat_text">Ret. ISLR</span>
                    </div>
                </button>
                <button name="action_view_wh_municipal"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        invisible="not l10n_ve_localization">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="l10n_ve_wh_municipal_count"/>
                        </span>
                        <span class="o_stat_text">Ret. Mun.</span>
                    </div>
                </button>
            </div>

        </field>
    </record>

    <!-- Pestaña Fiscal Venezuela360 y Selector de Tipo de Tasa -->
    <record id="view_move_form_l10n_ve_tab" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ve.tab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Selector de Tipo de Tasa en Encabezado -->
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="l10n_ve_rate_type" widget="radio" options="{'horizontal': true}" invisible="not l10n_ve_localization" readonly="state == 'posted'"/>
                <field name="l10n_ve_rate_applied" string="Tasa Aplicada (Bs/USD)" digits="[18, 6]" invisible="not l10n_ve_localization" readonly="l10n_ve_rate_type == 'bcv' or state == 'posted'"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Venezuela360" name="l10n_ve_fiscal" invisible="not l10n_ve_localization">
                    <group>
                        <group string="Control de Tasa y Dualidad Monetaria">
                            <field name="l10n_ve_rate_type" widget="radio" readonly="state == 'posted'"/>
                            <field name="l10n_ve_rate_applied" string="Tasa Aplicada (Bs/USD)" digits="[18, 6]" readonly="l10n_ve_rate_type == 'bcv' or state == 'posted'"/>
                            <field name="l10n_ve_rate" string="Tasa Oficial BCV" digits="[18, 6]" readonly="1"/>
                            <field name="l10n_ve_rate_date" string="Fecha Tasa BCV" readonly="state != 'draft'"/>
                            <field name="l10n_ve_is_usd_document" string="Documento en USD"/>
                        </group>
                        <group string="Datos Fiscales y Control SENIAT">
                            <field name="l10n_ve_control_number" string="Número de Control" readonly="state == 'posted'"/>
                            <field name="l10n_ve_journal_emission_medium" string="Medio de Emisión"/>
                            <field name="l10n_ve_fiscal_printer_serial" string="Serial Impresora Fiscal"/>
                            <field name="l10n_ve_requires_control" string="Requiere N° Control"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Totales Bimoneda Duales Integrados: Bolívares (Izq) y Dólares (Der) -->
            <xpath expr="//field[@name='narration']/parent::group" position="attributes">
                <attribute name="colspan">4</attribute>
            </xpath>
            <xpath expr="//field[@name='narration']/parent::group" position="after">
                <!-- Columna Central/Izquierda de Totales: Bolívares (Bs.F) -->
                <group colspan="4" class="oe_subtotal_footer" invisible="not l10n_ve_localization">
                    <field name="l10n_ve_amount_untaxed_bs" string="Base imponible Bs." widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}" readonly="1" invisible="not l10n_ve_is_usd_document"/>
                    <field name="l10n_ve_amount_tax_bs" string="Impuestos Bs." widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}" readonly="1" invisible="not l10n_ve_is_usd_document"/>
                    <field name="l10n_ve_amount_total_bs" string="Total Bs." widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}" readonly="1" class="oe_subtotal_footer_separator" invisible="not l10n_ve_is_usd_document"/>

                    <field name="l10n_ve_untaxed_ref" string="Base imponible Ref." widget="monetary" options="{'currency_field': 'l10n_ve_dual_ref_currency_id'}" readonly="1" invisible="l10n_ve_is_usd_document"/>
                    <field name="l10n_ve_tax_ref" string="Impuestos Ref." widget="monetary" options="{'currency_field': 'l10n_ve_dual_ref_currency_id'}" readonly="1" invisible="l10n_ve_is_usd_document"/>
                    <field name="l10n_ve_total_ref" string="Total Ref." widget="monetary" options="{'currency_field': 'l10n_ve_dual_ref_currency_id'}" readonly="1" class="oe_subtotal_footer_separator" invisible="l10n_ve_is_usd_document"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extensión de la Vista Lista de Facturas (account.view_invoice_tree) para Columnas Bimoneda Dual en Bs. -->
    <record id="view_invoice_tree_l10n_ve" model="ir.ui.view">
        <field name="name">account.invoice.list.l10n_ve</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="after">
                <field name="l10n_ve_amount_untaxed_bs" string="Impuestos no incl. (Bs)" sum="Total Subtotal Bs" optional="show" widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="l10n_ve_amount_total_bs" string="Total (Bs)" sum="Total General Bs" optional="show" decoration-bf="1" widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                <field name="l10n_ve_currency_bs_id" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- Extensión de la Vista Lista de Apuntes Contables (account.view_move_line_tree) para Columnas Duales Bs y USD -->
    <record id="view_move_line_tree_l10n_ve_dual" model="ir.ui.view">
        <field name="name">account.move.line.list.l10n_ve.dual</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='debit']" position="attributes">
                <attribute name="string">Débito $</attribute>
            </xpath>
            <xpath expr="//field[@name='credit']" position="attributes">
                <attribute name="string">Crédito $</attribute>
            </xpath>
            <xpath expr="//field[@name='debit']" position="before">
                <field name="l10n_ve_debit_bs" string="Débito (Bs)" optional="show" sum="Total Débito Bs" widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                <field name="l10n_ve_credit_bs" string="Crédito (Bs)" optional="show" sum="Total Crédito Bs" widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                <field name="l10n_ve_currency_bs_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='credit']" position="after">
                <field name="l10n_ve_rate_display" string="Tasa" optional="show" digits="[18, 6]"/>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="l10n_ve_amount_residual_bs" string="Importe residual (Bs)" optional="show" sum="Total Residual Bs"/>
            </xpath>
        </field>
    </record>

    <!-- Extensión de Apuntes dentro del Formulario de Asiento -->
    <record id="view_move_form_l10n_ve_lines_dual" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ve.lines.dual</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='debit']" position="before">
                <field name="l10n_ve_debit_bs" string="Débito (Bs)" optional="show" sum="Total Débito Bs"/>
                <field name="l10n_ve_credit_bs" string="Crédito (Bs)" optional="show" sum="Total Crédito Bs"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='credit']" position="after">
                <field name="l10n_ve_rate_display" string="Tasa" optional="show" digits="[18, 6]"/>
            </xpath>
        </field>
    </record>
</odoo>
