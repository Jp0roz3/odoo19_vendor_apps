<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión del Formulario de Pedidos de Venta (sale.order) -->
    <record id="view_order_form_l10n_ve_dual" model="ir.ui.view">
        <field name="name">sale.order.form.l10n_ve.dual</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Selector de Tipo de Tasa en Encabezado (Requerimiento 1) -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="l10n_ve_rate_type" widget="radio" options="{'horizontal': true}"/>
                <field name="l10n_ve_rate_applied" string="Tasa BCV Aplicada" digits="[18, 6]"/>
            </xpath>

            <!-- Totales Referenciales en Bolívares Integrados Limpios (Imagen 1) -->
            <xpath expr="//field[@name='tax_totals']/parent::group" position="before">
                <group class="oe_subtotal_footer" invisible="not l10n_ve_is_usd_order">
                    <field name="l10n_ve_untaxed_bs" string="Base imponible Bs." readonly="1"/>
                    <field name="l10n_ve_tax_bs" string="Impuestos Bs." readonly="1"/>
                    <field name="l10n_ve_total_bs" string="Total Bs." readonly="1" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
