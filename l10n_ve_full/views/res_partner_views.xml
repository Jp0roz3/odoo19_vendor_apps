<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de Contactos con Pestaña Datos Fiscales Venezuela -->
    <record id="view_partner_form_l10n_ve" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_ve</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Insertar campo RIF y Tipo RIF después de vat -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_ve_rif" string="RIF (SENIAT)" placeholder="J-12345678-9"/>
                <field name="l10n_ve_rif_type" invisible="1"/>
            </xpath>

            <!-- Ubicación Territorial Venezolana en la dirección estándar superior con filtrado dinámico en cascada -->
            <xpath expr="//field[@name='city']" position="after">
                <field name="l10n_ve_municipality_id" placeholder="Municipio" class="o_address_city" domain="[('state_id', '=?', state_id)]" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="l10n_ve_parish_id" placeholder="Parroquia" class="o_address_city" domain="[('municipality_id', '=?', l10n_ve_municipality_id)]" options="{'no_create_edit': True, 'no_open': True}"/>
            </xpath>

            <!-- Pestaña Datos Fiscales Venezuela -->
            <xpath expr="//notebook" position="inside">
                <page string="Datos Fiscales Venezuela" name="l10n_ve_fiscal_partner">
                    <group>
                        <group string="Clasificación Fiscal SENIAT">
                            <field name="l10n_ve_contributor_type" string="Tipo de Contribuyente"/>
                            <field name="l10n_ve_retention_agent_iva" string="¿Es Agente de Retención IVA?"/>
                            <field name="l10n_ve_retention_agent_islr" string="¿Es Agente de Retención ISLR?"/>
                            <field name="l10n_ve_seniat_registry" string="N° Registro SENIAT"/>
                        </group>
                        <group string="Retenciones ISLR y Municipal">
                            <field name="l10n_ve_islr_concept_id" string="Concepto ISLR por Defecto" options="{'no_create': True}"/>
                            <field name="l10n_ve_municipal_activity" string="Actividad Económica Municipal"/>
                            <field name="l10n_ve_municipal_rate" string="Tasa Ret. Municipal (%)"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
