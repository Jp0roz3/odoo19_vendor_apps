<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Extensión de Transacciones Bancarias (account.bank.statement.line)
        ================================================================================
        Incorpora:
          - Tasa Transacción (Bs/USD)
          - Importe ($) en la vista lista de transacciones del extracto
    -->
    <record id="view_bank_statement_line_tree_l10n_ve" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.l10n_ve</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account.view_bank_statement_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="l10n_ve_rate" string="Tasa Transacción" digits="[18, 6]" optional="show"/>
                <field name="l10n_ve_amount_usd" string="Importe ($)" digits="[18, 2]" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_form_l10n_ve" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.l10n_ve</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account.view_bank_statement_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="l10n_ve_rate" string="Tasa Transacción (Bs/USD)" digits="[18, 6]"/>
                <field name="l10n_ve_amount_usd" string="Importe en USD ($)" digits="[18, 2]"/>
            </xpath>
        </field>
    </record>
</odoo>
