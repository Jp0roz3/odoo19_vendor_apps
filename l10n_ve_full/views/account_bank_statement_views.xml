<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Vista de Transacciones Bancarias (account.bank.statement.line)
        ===========================================================================
        Vista primaria con prioridad alta para transacciones bancarias bimoneda.
    -->
    <!-- Extensión de la Vista Lista Estándar de Transacciones Bancarias -->
    <record id="view_bank_statement_line_tree_l10n_ve_inherit" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.l10n_ve.inherit</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account.view_bank_statement_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="before">
                <field name="l10n_ve_rate" string="Tasa Transacción" digits="[18, 6]" optional="show"/>
                <field name="l10n_ve_amount_usd" string="Importe ($)" digits="[18, 2]" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Extensión de la Vista Formulario Estándar de Transacción Bancaria -->
    <record id="view_bank_statement_line_form_l10n_ve_inherit" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.l10n_ve.inherit</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account.view_bank_statement_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="l10n_ve_rate" string="Tasa Transacción (Bs/USD)" digits="[18, 6]"/>
                <field name="l10n_ve_amount_usd" string="Importe en USD ($)" digits="[18, 2]"/>
            </xpath>
        </field>
    </record>
</odoo>
