<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Vista de Transacciones Bancarias (account.bank.statement.line)
        ===========================================================================
        Vista primaria con prioridad alta para transacciones bancarias bimoneda.
    -->
    <record id="view_bank_statement_line_tree_l10n_ve" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.l10n_ve</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Transacciones Bancarias">
                <field name="date"/>
                <field name="payment_ref" string="Etiqueta"/>
                <field name="partner_id" string="Contacto"/>
                <field name="journal_id" optional="hide"/>
                <field name="l10n_ve_rate" string="Tasa Transacción" digits="[18, 6]"/>
                <field name="amount" string="Importe"/>
                <field name="l10n_ve_amount_usd" string="Importe ($)" digits="[18, 2]"/>
                <field name="currency_id" optional="hide"/>
                <field name="is_reconciled" string="Conciliado"/>
            </list>
        </field>
    </record>

    <record id="view_bank_statement_line_form_l10n_ve" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.l10n_ve</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Transacción Bancaria">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="payment_ref" string="Etiqueta"/>
                            <field name="partner_id" string="Contacto"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="l10n_ve_rate" string="Tasa Transacción (Bs/USD)" digits="[18, 6]"/>
                            <field name="amount" string="Importe"/>
                            <field name="l10n_ve_amount_usd" string="Importe en USD ($)" digits="[18, 2]"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
