<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Dashboard Kanban DUAL COLOR (Coincidencia Exacta Foto 2 de Referencia)
        =====================================================================================
        Formato: $ 2,78 / 1.490,02 Bs.F
          - USD en ROJO (#dc3545)
          - Separador /
          - Bs en NEGRO (#1a1a1a)
    -->
    <record id="account_journal_dashboard_kanban_view_l10n_ve" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.l10n_ve</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">

            <!-- ═══════════════════════════════════════════════════════
                 VENTA / COMPRA → JournalBodySalePurchase
                 ═══════════════════════════════════════════════════════ -->

            <!-- sum_draft: Borradores -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.sum_draft']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_draft_usd or dashboard.sum_draft"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_draft_bs or ''"/>
                </span>
            </xpath>

            <!-- sum_waiting: Sin pagar / Sin cobrar -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.sum_waiting']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_waiting_usd or dashboard.sum_waiting"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_waiting_bs or ''"/>
                </span>
            </xpath>

            <!-- sum_late: Vencidos -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.sum_late']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_late_usd or dashboard.sum_late"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).sum_late_bs or ''"/>
                </span>
            </xpath>

            <!-- ═══════════════════════════════════════════════════════
                 BANCO / EFECTIVO → JournalBodyBankCash
                 ═══════════════════════════════════════════════════════ -->

            <!-- account_balance: Balance de cuenta -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.account_balance']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).account_balance_usd or dashboard.account_balance"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).account_balance_bs or ''"/>
                </span>
            </xpath>

            <!-- outstanding_pay_account_balance: Pagos pendientes -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.outstanding_pay_account_balance']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).outstanding_pay_balance_usd or dashboard.outstanding_pay_account_balance"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).outstanding_pay_balance_bs or ''"/>
                </span>
            </xpath>

            <!-- last_balance: Último extracto -->
            <xpath expr="//span[@dir='ltr'][.//t[@t-out='dashboard.last_balance']]" position="replace">
                <span dir="ltr" style="color:#dc3545;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).last_balance_usd or dashboard.last_balance"/>
                </span>
                <span style="color:#666666;margin:0 4px;">/</span>
                <span style="color:#1a1a1a;font-weight:bold;">
                    <t t-out="JSON.parse(record.kanban_dashboard.raw_value).last_balance_bs or ''"/>
                </span>
            </xpath>

        </field>
    </record>
</odoo>
