<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Venezuela360: Extensión del Modal "Pagar" (account.payment.register.form)
        ==========================================================================
        Alineación en filas independientes dentro de group2:
          - Adeudado Divisa Ref. ($)
          - Tipo de Tasa Pago (Factura / BCV / Comercial)
          - Tasa Pago Aplicada (Editable si es Comercial)
          - Mantener Bs
          - Importe ($ / Bs)
          - Aplicar IGTF (3%) [Solo en divisas extranjeras]
    -->
    <record id="view_account_payment_register_form_l10n_ve_dual" model="ir.ui.view">
        <field name="name">account.payment.register.form.l10n_ve.dual</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">

            <!-- Insertar campos duales y selector de tasa ANTES de la etiqueta amount -->
            <xpath expr="//label[@for='amount']" position="before">
                <field name="l10n_ve_is_foreign_currency" invisible="1"/>
                <field name="l10n_ve_amount_residual_ref"
                       string="Adeudado Divisa Ref."
                       readonly="1"
                       widget="monetary"
                       options="{'currency_field': 'custom_user_currency_id'}"/>
                <field name="l10n_ve_invoice_rate"
                       string="Tasa Factura"
                       readonly="1"
                       digits="[18, 6]"/>
                <field name="l10n_ve_current_rate"
                       string="Tasa Actual"
                       readonly="1"
                       digits="[18, 6]"/>
                <field name="l10n_ve_rate_type"
                       string="Tipo de Tasa Pago"
                       widget="radio"
                       options="{'horizontal': true}"/>
                <field name="l10n_ve_payment_rate"
                       string="Tasa Pago Aplicada"
                       digits="[18, 6]"
                       readonly="l10n_ve_rate_type != 'commercial'"/>
                <field name="l10n_ve_keep_bs"
                       string="Mantener Bs"/>
            </xpath>

            <!-- Insertar Aplicar IGTF como fila independiente DESPUÉS del div del importe (solo en divisas) -->
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="l10n_ve_apply_igtf"
                       string="Aplicar IGTF (3%)"
                       invisible="not l10n_ve_is_foreign_currency"/>
            </xpath>

        </field>
    </record>

    <!-- Extensión de la Vista Formulario de Pagos (account.payment.form) -->
    <record id="view_account_payment_form_l10n_ve_dual" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_ve.dual</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="l10n_ve_rate_type" string="Tipo de Tasa" readonly="state != 'draft'"/>
                <field name="l10n_ve_rate" string="Tasa del Pago" digits="[18, 6]" readonly="state != 'draft'"/>
                <field name="l10n_ve_amount_bs" string="Monto en Bs." widget="monetary" options="{'currency_field': 'l10n_ve_currency_bs_id'}"/>
                <field name="l10n_ve_amount_usd" string="Monto en USD ($)"/>
                <field name="l10n_ve_apply_igtf" string="IGTF Aplicado" readonly="state != 'draft'"/>
                <field name="l10n_ve_igtf_amount" string="Monto IGTF (3%)" invisible="not l10n_ve_apply_igtf" readonly="state != 'draft'"/>
                <field name="l10n_ve_currency_bs_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
