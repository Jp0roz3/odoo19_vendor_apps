<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exchange_rate_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ve.exchange.rate.wizard.form</field>
        <field name="model">l10n_ve.exchange.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="Carga Masiva de Tasas BCV">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_from_id"/>
                    <field name="currency_to_id"/>
                    <field name="overwrite_existing"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="date"/>
                        <field name="rate" string="Bs/USD" digits="[18,6]"/>
                        <field name="source"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_rates" string="Registrar Tasas"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_exchange_rate_wizard" model="ir.actions.act_window">
        <field name="name">Carga Masiva de Tasas BCV</field>
        <field name="res_model">l10n_ve.exchange.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
