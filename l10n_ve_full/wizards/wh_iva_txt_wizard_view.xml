<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wh_iva_txt_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ve.wh.iva.txt.wizard.form</field>
        <field name="model">l10n_ve.wh.iva.txt.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar TXT Retenciones IVA (SENIAT)">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Estructura Oficial SENIAT:</strong> Este asistente genera el archivo plano <code>.txt</code> de 14 campos reglamentario para la declaración de retenciones de IVA en el portal fiscal del SENIAT.
                    </div>
                    <group invisible="state == 'done'">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="fortnight" widget="radio"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <div invisible="state != 'done'" class="text-center p-3">
                        <h4><i class="fa fa-check-circle text-success me-2"/>¡Archivo TXT de Retenciones IVA generado con éxito!</h4>
                        <p class="text-muted">Haz clic en el enlace para descargar el archivo y cargarlo en el portal del SENIAT:</p>
                        <div class="mt-3">
                            <field name="txt_file" filename="txt_filename" widget="binary"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate_txt" string="Generar Archivo TXT" type="object" class="btn-primary" invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wh_iva_txt_wizard" model="ir.actions.act_window">
        <field name="name">Generar TXT IVA</field>
        <field name="res_model">l10n_ve.wh.iva.txt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
